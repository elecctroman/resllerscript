{
  "info": {
    "name": "Reseller API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"}
        ],
        "url": {
          "raw": "{{api_url}}/v1/auth/login",
          "host": ["{{api_url}}"],
          "path": ["v1", "auth", "login"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"secret\"\n}"
        }
      }
    },
    {
      "name": "List Products",
      "request": {
        "method": "GET",
        "header": [
          {"key": "X-API-KEY", "value": "{{api_key}}"},
          {"key": "X-API-SECRET", "value": "{{api_secret}}"},
          {"key": "X-CLIENT-DOMAIN", "value": "example.com"}
        ],
        "url": {
          "raw": "{{api_url}}/v1/products",
          "host": ["{{api_url}}"],
          "path": ["v1", "products"]
        }
      }
    },
    {
      "name": "Create Order",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "X-API-KEY", "value": "{{api_key}}"},
          {"key": "X-API-SECRET", "value": "{{api_secret}}"}
        ],
        "url": {
          "raw": "{{api_url}}/v1/order/create",
          "host": ["{{api_url}}"],
          "path": ["v1", "order", "create"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_id\": 24,\n  \"note\": \"API order\",\n  \"external_reference\": \"POSTMAN-1\"\n}"
        }
      }
    },
    {
      "name": "Order Status",
      "request": {
        "method": "GET",
        "header": [
          {"key": "X-API-KEY", "value": "{{api_key}}"},
          {"key": "X-API-SECRET", "value": "{{api_secret}}"}
        ],
        "url": {
          "raw": "{{api_url}}/v1/order/status?external_reference=POSTMAN-1",
          "host": ["{{api_url}}"],
          "path": ["v1", "order", "status"],
          "query": [
            {"key": "external_reference", "value": "POSTMAN-1"}
          ]
        }
      }
    },
    {
      "name": "Balance",
      "request": {
        "method": "GET",
        "header": [
          {"key": "X-API-KEY", "value": "{{api_key}}"},
          {"key": "X-API-SECRET", "value": "{{api_secret}}"}
        ],
        "url": {
          "raw": "{{api_url}}/v1/balance",
          "host": ["{{api_url}}"],
          "path": ["v1", "balance"]
        }
      }
    },
    {
      "name": "User Info",
      "request": {
        "method": "GET",
        "header": [
          {"key": "X-API-KEY", "value": "{{api_key}}"},
          {"key": "X-API-SECRET", "value": "{{api_secret}}"}
        ],
        "url": {
          "raw": "{{api_url}}/v1/user/info",
          "host": ["{{api_url}}"],
          "path": ["v1", "user", "info"]
        }
      }
    },
    {
      "name": "Create API Key",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{bearer_token}}"}
        ],
        "url": {
          "raw": "{{api_url}}/v1/api-keys/create",
          "host": ["{{api_url}}"],
          "path": ["v1", "api-keys", "create"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"allowed_domains\": [\"example.com\"],\n  \"allowed_ips\": [\"1.1.1.1\"]\n}"
        }
      }
    },
    {
      "name": "List API Keys",
      "request": {
        "method": "GET",
        "header": [
          {"key": "Authorization", "value": "Bearer {{bearer_token}}"}
        ],
        "url": {
          "raw": "{{api_url}}/v1/api-keys/list",
          "host": ["{{api_url}}"],
          "path": ["v1", "api-keys", "list"]
        }
      }
    },
    {
      "name": "Revoke API Key",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{bearer_token}}"}
        ],
        "url": {
          "raw": "{{api_url}}/v1/api-keys/revoke",
          "host": ["{{api_url}}"],
          "path": ["v1", "api-keys", "revoke"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"key\": \"{{api_key}}\"\n}"
        }
      }
    }
  ]
}
